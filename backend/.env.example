# App runtime
APP_NAME=Scout API
APP_ENV=local
APP_VERSION=0.1.0
DEBUG=true

# AI Studio / Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-pro-preview

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
AUTH_REQUIRED=false

# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
